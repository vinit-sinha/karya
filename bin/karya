#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import uuid
from pathlib import Path

# ── constants ────────────────────────────────────────────────────────────────

KARYA_VERSION = "2.0"
KARYA_DIR = ".karya"
CUSTOMIZATIONS_SUBDIR = "customizations"

MARKER_WORKSPACE   = ".karya-workspace"
MARKER_DOMAIN      = ".karya-domain"
MARKER_COLLECTION  = ".karya-collection"
MARKER_PROJECT     = ".karya-project"
MARKER_SUBPROJECT  = ".karya-subproject"

# Ordered by URI segment index (0-based)
SEGMENT_MARKERS = [MARKER_DOMAIN, MARKER_COLLECTION, MARKER_PROJECT]

PROJECT_FILE           = "PROJECT.md"
STATE_CHECKPOINT_DIR   = ".karya/state-checkpoints"
DEFAULT_CHECKPOINT_NAME = "latest"
SCRIPT_ROOT    = Path(__file__).resolve().parent.parent
TEMPLATES_ROOT = SCRIPT_ROOT / "templates"

# ── utilities ─────────────────────────────────────────────────────────────────

def fail(message: str) -> None:
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(1)


def load_text(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def write_text(path: Path, text: str) -> None:
    path.write_text(text, encoding="utf-8")


def ask_confirmation(prompt: str, default: bool = False) -> bool:
    if not sys.stdin.isatty():
        return default
    suffix = " [Y/n]: " if default else " [y/N]: "
    answer = input(prompt + suffix).strip().lower()
    if answer == "":
        return default
    return answer in {"y", "yes"}


def ask_choice(prompt: str, choices: list[str], default: str) -> str:
    if not sys.stdin.isatty():
        return default
    choices_str = "/".join(c.upper() if c == default else c.lower() for c in choices)
    while True:
        answer = input(f"{prompt} [{choices_str}]: ").strip().lower()
        if not answer:
            return default
        if answer in [c.lower() for c in choices]:
            return answer

# ── URI handling ──────────────────────────────────────────────────────────────

def parse_uri(uri: str) -> tuple[str, str]:
    """Return (scheme, path) from a URI string like kosh://a/b or file:///x."""
    if "://" not in uri:
        fail(f"Invalid URI — missing scheme (expected kosh:// or file://): {uri}")
    scheme, _, path = uri.partition("://")
    scheme = scheme.lower().strip()
    if scheme not in ("kosh", "file"):
        fail(f"Unsupported URI scheme '{scheme}'. Supported schemes: kosh://, file://")
    return scheme, path


def parse_kosh_path(path: str) -> list[str]:
    """Validate and split a kosh path into segments. Minimum 2 segments required."""
    parts = [p for p in path.strip("/").split("/") if p]
    if len(parts) < 2:
        fail(
            f"kosh:// URI must have at least two path segments (domain/project), "
            f"e.g. kosh://learning/mit/6s081 — got: kosh://{path}"
        )
    return parts


def segment_marker(index: int) -> str:
    """Return the marker filename for a given URI segment index."""
    if index < len(SEGMENT_MARKERS):
        return SEGMENT_MARKERS[index]
    return MARKER_SUBPROJECT


def segment_level(index: int) -> str:
    """Return the level name for a given URI segment index."""
    levels = ["domain", "collection", "project"]
    return levels[index] if index < len(levels) else "subproject"


def resolve_uri(uri: str, workspace_root: Path | None) -> Path:
    """Resolve a kosh:// or file:// URI to an absolute filesystem path."""
    scheme, path = parse_uri(uri)
    if scheme == "kosh":
        if workspace_root is None:
            fail("kosh:// URI requires a workspace. Run 'karya init workspace' first.")
        parts = parse_kosh_path(path)
        result = workspace_root
        for part in parts:
            result = result / part
        return result
    else:  # file://
        if not path.startswith("/"):
            fail(f"file:// URI must use an absolute path, e.g. file:///home/user/project — got: file://{path}")
        return Path(path)

# ── workspace ─────────────────────────────────────────────────────────────────

def find_workspace_root(start: Path) -> Path | None:
    """Walk up the filesystem looking for a .karya-workspace marker."""
    current = start.resolve()
    while True:
        if (current / MARKER_WORKSPACE).exists():
            return current
        if current.parent == current:
            return None
        current = current.parent


def write_marker(directory: Path, level: str, uri: str, extra: dict | None = None) -> None:
    """Write a .karya-<level> JSON marker file. No-op if it already exists (unless extra provided)."""
    marker_name = {
        "workspace":   MARKER_WORKSPACE,
        "domain":      MARKER_DOMAIN,
        "collection":  MARKER_COLLECTION,
        "project":     MARKER_PROJECT,
        "subproject":  MARKER_SUBPROJECT,
    }[level]
    marker_path = directory / marker_name
    if marker_path.exists() and not extra:
        return
    payload: dict = {
        "karya_version": KARYA_VERSION,
        "level": level,
        "uri": uri,
        "created_at": datetime.date.today().isoformat(),
    }
    if extra:
        payload.update(extra)
    marker_path.write_text(
        json.dumps(payload, indent=2),
        encoding="utf-8",
    )


def read_project_marker(project_root: Path) -> dict:
    marker_path = project_root / MARKER_PROJECT
    if not marker_path.exists():
        return {}
    try:
        return json.loads(marker_path.read_text(encoding="utf-8"))
    except Exception:
        return {}


def set_project_setup_status(project_root: Path, uri: str, status: str) -> None:
    marker_path = project_root / MARKER_PROJECT
    data = read_project_marker(project_root)
    data["setup_status"] = status
    marker_path.write_text(json.dumps(data, indent=2), encoding="utf-8")


def init_workspace() -> None:
    root = Path.cwd()
    marker = root / MARKER_WORKSPACE
    if marker.exists():
        fail(f"Workspace already initialised at {root}")
    write_marker(root, "workspace", "kosh://")
    for directory in ["learning", "experiments", "projects", "archive"]:
        (root / directory).mkdir(parents=True, exist_ok=True)
    print(f"Initialised workspace at {root}")

# ── template & hooks ──────────────────────────────────────────────────────────

def find_template_root(domain: str) -> Path:
    """Locate the template directory for the given domain."""
    candidate = TEMPLATES_ROOT / domain
    if candidate.is_dir():
        return candidate
    fail(
        f"No template found for domain '{domain}'. "
        f"Expected a directory at {candidate}. "
        f"Available domains: {', '.join(sorted(p.name for p in TEMPLATES_ROOT.iterdir() if p.is_dir() and p.name != KARYA_DIR))}"
    )


def is_mps_node(directory: Path) -> bool:
    """True if this directory is an MPS node in the template hierarchy (has a .karya/ child)."""
    return (directory / KARYA_DIR).is_dir()


def copy_template(template_root: Path, project_root: Path) -> None:
    """
    Copy template_root into project_root, excluding:
    - Any directory named .karya (karya internals, never user content)
    - Any first-level subdirectory that is itself an MPS node (has .karya/ child)
    """
    def ignore(src: str, names: list[str]) -> set[str]:
        src_path = Path(src)
        ignored = set()
        for name in names:
            if name == KARYA_DIR:
                ignored.add(name)
                continue
            child = src_path / name
            if child.is_dir() and is_mps_node(child):
                ignored.add(name)
        return ignored

    shutil.copytree(str(template_root), str(project_root), ignore=ignore)


def discover_hooks(uri_parts: list[str]) -> list[Path]:
    """
    Collect .karya/customizations/ directories from the template hierarchy,
    ordered from most-general (root) to most-specific (project level).
    """
    hooks: list[Path] = []

    root_hooks = TEMPLATES_ROOT / KARYA_DIR / CUSTOMIZATIONS_SUBDIR
    if root_hooks.is_dir():
        hooks.append(root_hooks)

    current = TEMPLATES_ROOT
    for part in uri_parts:
        current = current / part
        candidate = current / KARYA_DIR / CUSTOMIZATIONS_SUBDIR
        if candidate.is_dir():
            hooks.append(candidate)

    return hooks


def run_hook(customizations_dir: Path, event: str, cwd: Path) -> bool:
    """
    Run <event>.sh from customizations_dir with cwd as the working directory.
    Scripts receive no arguments and no environment variables — they use
    $(dirname "$0") to locate themselves and walk up via marker files for context.
    Pre-create failure aborts. Post-create failure warns and returns False.
    Returns True on success (or when no script exists).
    """
    script = customizations_dir / f"{event}.sh"
    if not script.exists():
        return True
    bash = shutil.which("bash")
    if bash is None:
        print(
            f"  Warning: bash not found — cannot run {script.name}.\n"
            f"  On Windows, install Git for Windows (https://git-scm.com) which bundles bash,\n"
            f"  or use WSL. Then re-run: karya create project --uri <uri> --continue"
        )
        return False
    rel = customizations_dir.relative_to(TEMPLATES_ROOT)
    print(f"  [{event}] {rel}")
    result = subprocess.run([bash, str(script)], cwd=str(cwd), check=False)
    if result.returncode != 0:
        if event == "pre-create":
            fail(f"{script.name} exited with code {result.returncode}; aborting.")
        else:
            print(f"  Warning: {script.name} exited with code {result.returncode}")
            return False
    return True

# ── project metadata ──────────────────────────────────────────────────────────

def subst_project_metadata(content: str, name: str, uri: str, created: str) -> str:
    lines = []
    for line in content.splitlines():
        stripped = line.lstrip()
        if stripped.startswith("Name:"):
            lines.append(f"Name: {name}")
        elif stripped.startswith("URI:"):
            lines.append(f"URI: {uri}")
        elif stripped.startswith("Created:"):
            lines.append(f"Created: {created}")
        elif stripped.startswith("Status:"):
            lines.append("Status: Active")
        else:
            lines.append(line)
    return "\n".join(lines).rstrip() + "\n"

# ── commands ──────────────────────────────────────────────────────────────────

def _auto_publish(project_root: Path, uri: str, publish: bool) -> None:
    """Publish the project to GitHub after successful setup, unless --no-publish was given."""
    if not publish:
        print(f"  Skipping publish (--no-publish). To publish later:")
        print(f"    karya publish project --uri {uri}")
        return
    print(f"\nPublishing project to GitHub...")
    owner = gh_get_authenticated_user()
    try:
        publish_project(uri=uri, owner=owner)
    except SystemExit:
        print(f"  Warning: publish failed — project has no remote yet.")
        print(f"  Run manually: karya publish project --uri {uri}")


def _derive_repo_slug(uri_parts: list[str]) -> str:
    return "-".join(uri_parts)


def _clone_from_remote(uri_parts: list[str], project_root: Path, workspace_root: Path) -> bool:
    """
    If the expected GitHub repo already exists, clone it into project_root.
    Returns True if the project was cloned (machine-2 path), False if remote doesn't exist.
    """
    if not gh_available():
        return False
    owner = gh_get_authenticated_user()
    if not owner:
        return False
    slug = _derive_repo_slug(uri_parts)
    repo_exists = gh_repo_exists(owner, slug)
    if repo_exists is not True:
        return False
    repo_url = f"https://github.com/{owner}/{slug}.git"
    print(f"Remote repository {owner}/{slug} already exists — cloning instead of creating fresh.")
    project_root.parent.mkdir(parents=True, exist_ok=True)

    # Clone the parent repo without recursing into submodules first.
    result = subprocess.run(["git", "clone", repo_url, str(project_root)], check=False)
    if result.returncode != 0:
        fail(f"Failed to clone {repo_url}")

    # Init submodules following the branch stored in .gitmodules (not a pinned SHA).
    # This avoids "not our ref" errors when the submodule is on an unmerged branch.
    sub_result = subprocess.run(
        ["git", "submodule", "update", "--init", "--remote"],
        cwd=str(project_root), check=False,
    )
    if sub_result.returncode != 0:
        print("  Warning: one or more submodules could not be initialised.")
        print("  Run manually once the relevant branches are pushed:")
        print(f"    git -C {project_root} submodule update --init --remote")

    # Ensure intermediate marker files exist on this machine.
    current = workspace_root
    for i, part in enumerate(uri_parts):
        current = current / part
        current.mkdir(parents=True, exist_ok=True)
        partial_uri = "kosh://" + "/".join(uri_parts[: i + 1])
        write_marker(current, segment_level(i), partial_uri)

    print(f"Cloned '{uri_parts[-1]}' into {project_root}")

    # Offer to apply the latest workstate checkpoint (branches + uncommitted patches).
    checkpoint_path = get_checkpoint_file(project_root, DEFAULT_CHECKPOINT_NAME)
    if checkpoint_path.exists():
        if ask_confirmation(
            "Latest workstate checkpoint found. Apply it now (restore branches + uncommitted changes)?",
            default=True,
        ):
            resume_workstate(checkpoint_name=DEFAULT_CHECKPOINT_NAME, apply_patch=True, project_root=project_root)
    return True


def _install_post_push_hook(git_root: Path, project_root: Path) -> None:
    """Install a post-push hook that auto-saves a karya workstate checkpoint."""
    hooks_dir = git_root / ".git" / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    hook_path = hooks_dir / "post-push"
    if hook_path.exists():
        return

    is_submodule = git_root != project_root
    if is_submodule:
        # Walk up from the submodule to find the karya project root, then save from there.
        script = """\
#!/bin/bash
# Auto-save karya workstate after push (from submodule — walks up to project root)
dir="$(pwd)"
while [ "$dir" != "/" ]; do
    if [ -f "$dir/.karya-project" ]; then
        (cd "$dir" && karya workstate save --description "auto-checkpoint after push" 2>/dev/null || true)
        break
    fi
    dir="$(dirname "$dir")"
done
"""
    else:
        script = """\
#!/bin/bash
# Auto-save karya workstate after push
karya workstate save --description "auto-checkpoint after push" 2>/dev/null || true
"""
    hook_path.write_text(script, encoding="utf-8")
    hook_path.chmod(0o755)
    label = "submodule" if is_submodule else "project"
    print(f"  Installed post-push workstate hook ({label}: {git_root.name})")


def _register_embedded_git_repos(project_root: Path) -> None:
    """
    Detect nested git repos created by post-create hooks (e.g. a cloned xv6),
    register them as git submodules with their active branch recorded in .gitmodules,
    and install a post-push hook so pushes from the submodule trigger a workstate save.
    """
    for git_dir in sorted(project_root.rglob(".git")):
        if git_dir == project_root / ".git":
            continue
        if not git_dir.is_dir():
            continue
        nested_root = git_dir.parent
        rel = str(nested_root.relative_to(project_root))

        # Skip if already registered
        gitmodules = project_root / ".gitmodules"
        if gitmodules.exists() and rel in gitmodules.read_text(encoding="utf-8"):
            _install_post_push_hook(nested_root, project_root)
            continue

        remote_url = git_remote_get_url(nested_root)
        if not remote_url:
            print(f"  Warning: embedded git repo at {rel} has no remote — skipping submodule registration.")
            print(f"    Add a remote to {nested_root} then run: git submodule add <url> {rel}")
            continue

        current_branch = get_git_branch(nested_root)
        print(f"  Registering embedded repo at '{rel}' as a git submodule (branch: {current_branch})")
        # Remove from index if it was staged as plain files
        run_git_command(["rm", "--cached", "-r", rel], cwd=project_root)
        # -b records the branch in .gitmodules so machine-2 clones can follow it
        add_args = ["submodule", "add"]
        if current_branch:
            add_args += ["-b", current_branch]
        add_args += [remote_url, rel]
        result = run_git_command(add_args, cwd=project_root)
        if result.returncode != 0:
            print(f"  Warning: failed to register '{rel}' as submodule: {result.stderr.strip()}")
            print(f"    Run manually: git submodule add -b {current_branch} {remote_url} {rel}")
        else:
            print(f"  Registered '{rel}' as submodule.")
            _install_post_push_hook(nested_root, project_root)


def create_project(uri: str, mode: str = "new", publish: bool = True) -> None:
    """
    mode: "new"     — first-time create; if remote already exists, clone it instead
          "continue" — re-run post-create hooks on an interrupted project
          "restart"  — delete and recreate from scratch
    publish: auto-publish to GitHub after successful setup (skip with --no-publish)
    """
    scheme, path = parse_uri(uri)
    if scheme != "kosh":
        fail(f"'karya create project' requires a kosh:// URI — got: {uri}")

    uri_parts = parse_kosh_path(path)
    domain = uri_parts[0]
    project_name = uri_parts[-1]

    workspace_root = find_workspace_root(Path.cwd())
    if workspace_root is None:
        fail("No workspace found. Run 'karya init workspace' from inside a workspace directory.")

    template_root = find_template_root(domain)
    project_root = resolve_uri(uri, workspace_root)

    # ── Detect existing state ────────────────────────────────────────────────
    if project_root.exists():
        marker = read_project_marker(project_root)
        setup_status = marker.get("setup_status", "complete")

        if mode == "new":
            if setup_status == "in_progress":
                print(f"Project setup was interrupted at {project_root}")
                print(f"  Run with --continue to resume post-create hooks")
                print(f"  Run with --restart  to delete and start fresh")
                return
            else:
                fail(
                    f"Project already exists and is fully set up at {project_root}\n"
                    f"  Use --restart to delete and recreate it."
                )

        if mode == "restart":
            import shutil as _shutil
            print(f"Removing existing project at {project_root} ...")
            _shutil.rmtree(project_root)
            # Fall through to fresh create below

        if mode == "continue":
            if setup_status == "complete":
                print(f"Project at {project_root} is already fully set up.")
                print(f"  Use --restart to delete and recreate it.")
                return
            print(f"Continuing setup of '{project_name}' at {project_root} ...")
            hooks = discover_hooks(uri_parts)
            set_project_setup_status(project_root, uri, "in_progress")
            if hooks:
                print("Post-create hooks:")
            hooks_ok = all(run_hook(h, "post-create", project_root) for h in hooks)
            if hooks_ok:
                set_project_setup_status(project_root, uri, "complete")
                _register_embedded_git_repos(project_root)
                print(f"Setup of '{project_name}' complete.")
                _auto_publish(project_root, uri, publish)
            else:
                print(f"Setup of '{project_name}' incomplete — one or more hooks failed.")
                print(f"  Fix the issue above, then re-run:")
                print(f"    karya create project --uri {uri} --continue")
            return

    # ── Check if remote already exists (machine-2 path) ──────────────────────
    if mode == "new" and _clone_from_remote(uri_parts, project_root, workspace_root):
        print(f"Project '{project_name}' is ready. Run 'karya workstate resume' to restore your last checkpoint.")
        return

    # ── Fresh create ─────────────────────────────────────────────────────────
    hooks = discover_hooks(uri_parts)

    # Pre-create hooks — project doesn't exist yet, run from workspace root
    if hooks:
        print("Pre-create hooks:")
    for hook_dir in hooks:
        run_hook(hook_dir, "pre-create", workspace_root)

    # Copy template (excluding .karya/ and MPS nodes)
    project_root.parent.mkdir(parents=True, exist_ok=True)
    copy_template(template_root, project_root)

    # Write marker files at each level; project marker gets setup_status=in_progress
    current = workspace_root
    for i, part in enumerate(uri_parts):
        current = current / part
        current.mkdir(parents=True, exist_ok=True)
        partial_uri = "kosh://" + "/".join(uri_parts[: i + 1])
        level = segment_level(i)
        extra = {"setup_status": "in_progress"} if level == "project" else None
        write_marker(current, level, partial_uri, extra=extra)

    # Substitute metadata in PROJECT.md
    created_date = datetime.date.today().isoformat()
    project_md_path = project_root / PROJECT_FILE
    if project_md_path.exists():
        project_md_text = load_text(project_md_path)
        project_md_text = subst_project_metadata(project_md_text, project_name, uri, created_date)
        write_text(project_md_path, project_md_text)

    readme_path = project_root / "README.md"
    if readme_path.exists():
        d = uri_parts[0] if len(uri_parts) > 0 else ""
        c = uri_parts[1] if len(uri_parts) > 1 else ""
        p = uri_parts[2] if len(uri_parts) > 2 else project_name
        readme = load_text(readme_path)
        readme = readme.replace("{{PROJECT_NAME}}", project_name)
        readme = readme.replace("{{DOMAIN}}", d)
        readme = readme.replace("{{COLLECTION}}", c)
        readme = readme.replace("{{PROJECT}}", p)
        readme = readme.replace("PROJECT_NAME", project_name)  # legacy
        write_text(readme_path, readme)

    print(f"Created project '{project_name}' at {project_root}")

    # Git init
    init_result = run_git_command(["init"], cwd=project_root)
    if init_result.returncode != 0:
        fail(f"Failed to initialise git repository: {init_result.stderr}")

    if run_git_command(["config", "user.name"], cwd=project_root).returncode != 0:
        run_git_command(["config", "local", "user.name", "Karya User"], cwd=project_root)
        run_git_command(["config", "local", "user.email", "karya@localhost"], cwd=project_root)

    add_result = run_git_command(["add", "."], cwd=project_root)
    if add_result.returncode != 0:
        fail(f"Failed to stage files: {add_result.stderr}")

    commit_result = run_git_command(
        ["commit", "-m", f"Initial project skeleton for {project_name}"],
        cwd=project_root,
    )
    if commit_result.returncode != 0:
        print(f"Warning: Failed to create initial commit: {commit_result.stderr.strip()}")

    print(f"Initialised git repository and created initial commit for '{project_name}'")
    _install_post_push_hook(project_root, project_root)

    # Post-create hooks — project now exists, run from project root
    if hooks:
        print("Post-create hooks:")
    hooks_ok = all(run_hook(h, "post-create", project_root) for h in hooks)
    if hooks_ok:
        set_project_setup_status(project_root, uri, "complete")
        _register_embedded_git_repos(project_root)
        print(f"Setup of '{project_name}' complete.")
        _auto_publish(project_root, uri, publish)
    else:
        print(f"Setup of '{project_name}' incomplete — one or more hooks failed.")
        print(f"  Fix the issue above, then re-run:")
        print(f"    karya create project --uri {uri} --continue")


def remove_project(uri: str) -> None:
    workspace_root = find_workspace_root(Path.cwd())
    project_root = resolve_uri(uri, workspace_root)

    if not project_root.exists():
        fail(f"Project not found at {project_root}")

    marker = project_root / MARKER_PROJECT
    if not marker.exists():
        fail(f"{project_root} does not appear to be a karya project (missing {MARKER_PROJECT})")

    git_root = find_git_root(project_root)
    relative_path = project_root.relative_to(git_root) if git_root else None

    shutil.rmtree(project_root)
    print(f"Removed project at {project_root}")

    print("\nNext steps for cleanup:")
    if git_root is not None:
        rel = str(relative_path) if relative_path != Path(".") else "."
        print(f"  1. cd {git_root}")
        print(f"  2. git rm -r {rel}")
        print(f"  3. git commit -m \"Remove project {project_root.name}\"")
        print("  4. git push")
        remote_url = discover_git_remote(git_root)
        if remote_url:
            print(f"  5. Clean up remote repository if needed: {remote_url}")
    else:
        print("  No git repository detected for this project.")


def publish_project(
    uri: str | None = None,
    repo_url_override: str | None = None,
    owner: str | None = None,
) -> None:
    workspace_root = find_workspace_root(Path.cwd())

    if uri is not None:
        project_root = resolve_uri(uri, workspace_root)
        if not project_root.exists():
            fail(f"Project not found: {project_root}")
    else:
        # Locate project by walking up from cwd
        current = Path.cwd().resolve()
        project_root = None
        while True:
            if (current / MARKER_PROJECT).exists():
                project_root = current
                break
            if (current / MARKER_WORKSPACE).exists() or current.parent == current:
                break
            current = current.parent
        if project_root is None:
            fail("No project found. Run from inside a project or pass --uri.")

    project_md_path = project_root / PROJECT_FILE
    if not project_md_path.exists():
        fail(f"Missing {PROJECT_FILE} at {project_root}")

    project_md_text = load_text(project_md_path)
    project_uri = next(
        (line.split(":", 1)[1].strip() for line in project_md_text.splitlines() if line.startswith("URI:")),
        None,
    )

    git_root = find_git_root(project_root)
    remote_repo_url = discover_git_remote(git_root) if git_root else None
    published_date = datetime.date.today().isoformat()

    # Auto-detect owner from gh auth when not supplied
    if owner is None and gh_available():
        owner = gh_get_authenticated_user()

    # Determine repo URL
    if repo_url_override:
        repo_url = repo_url_override
        print(f"Using explicit repository URL: {repo_url}")
    elif remote_repo_url:
        repo_url = remote_repo_url
    elif project_uri:
        _, path = parse_uri(project_uri)
        slug = path.strip("/").replace("/", "-")
        if owner:
            repo_url = f"https://github.com/{owner}/{slug}.git"
            print(f"Derived repository URL: {repo_url}")
        else:
            print(f"Suggested repository URL: https://github.com/<owner>/{slug}.git")
            repo_url = None
    else:
        repo_url = None

    # `published` tracks whether a remote is actually confirmed to exist and
    # be configured — PROJECT.md must only claim "Published" when this is
    # true. ask_confirmation()/ask_choice() silently return their default
    # when stdin isn't a TTY (e.g. a scripted `karya create project` run),
    # so without this guard a non-interactive run would print success and
    # write a Repository: URL for a repo that was never actually created.
    published = False
    if git_root is None:
        print("Warning: no git repository detected. Only updating metadata.")
    else:
        if remote_repo_url is None and repo_url is not None:
            if not gh_available():
                print("Warning: gh CLI not available. Create the repository manually before pushing.")
            else:
                remote_info = parse_github_repo_from_url(repo_url)
                if remote_info:
                    owner_name, repo_name = remote_info
                    repo_exists = gh_repo_exists(owner_name, repo_name)
                    if repo_exists is False:
                        if ask_confirmation(f"Create GitHub repository {owner_name}/{repo_name}?"):
                            visibility = ask_choice("Visibility", ["public", "private"], "private")
                            if not gh_create_repo(owner_name, repo_name, private=(visibility == "private")):
                                fail("Failed to create GitHub repository.")
                            print(f"Created {owner_name}/{repo_name}.")
                            git_remote_add_origin(git_root, repo_url)
                            published = True
                            if ask_confirmation("Push now?", default=True):
                                if not git_push_current_branch(git_root):
                                    fail("Failed to push.")
                        else:
                            print(f"Skipped creating {owner_name}/{repo_name} "
                                  f"(no interactive terminal, or declined). Run "
                                  f"'karya publish project --uri {project_uri or uri}' "
                                  f"from an interactive shell to create and push it.")
                    elif repo_exists is True:
                        if git_remote_get_url(git_root) is None:
                            git_remote_add_origin(git_root, repo_url)
                        published = True
                        if ask_confirmation("Push to remote?", default=True):
                            if not git_push_current_branch(git_root):
                                fail("Failed to push.")
        elif remote_repo_url is not None:
            published = True
            remote_empty = git_remote_is_empty(git_root)
            if remote_empty is True:
                if not ask_confirmation(f"Remote appears empty. Reuse it?"):
                    fail("Publish aborted.")
                if ask_confirmation("Push now?", default=True):
                    if not git_push_current_branch(git_root):
                        fail("Failed to push.")
            elif remote_empty is None:
                if not ask_confirmation("Unable to determine remote state. Continue with metadata update?", default=True):
                    fail("Publish aborted.")

    if not published:
        print(f"Not published — metadata left unchanged.")
        return

    # Update PROJECT.md
    lines = project_md_text.splitlines()
    new_lines = []
    for line in lines:
        if line.startswith("Status:"):
            new_lines.append("Status: Published")
        elif line.startswith("Repository:") and repo_url:
            new_lines.append(f"Repository: {repo_url}")
        else:
            new_lines.append(line)

    if not any(l.startswith("Published:") for l in lines):
        for idx, line in enumerate(new_lines):
            if line.startswith("Status:"):
                new_lines.insert(idx + 1, f"Published: {published_date}")
                break

    if repo_url and not any(l.startswith("Repository:") for l in lines):
        new_lines.append(f"Repository: {repo_url}")

    write_text(project_md_path, "\n".join(new_lines).rstrip() + "\n")
    print(f"Published project at {project_root}")

    if git_root is not None:
        run_git_command(["add", str(project_md_path)], cwd=git_root)
        run_git_command(["commit", "-m", "Publish project and update metadata"], cwd=git_root)
        print("Committed metadata update.")

# ── workstate ─────────────────────────────────────────────────────────────────

def sanitize_checkpoint_name(name: str | None) -> str:
    if name is None or not name.strip():
        return DEFAULT_CHECKPOINT_NAME
    sanitized = "".join(ch if ch.isalnum() or ch in "-_" else "_" for ch in name.strip())
    if not sanitized:
        fail("Checkpoint name must contain at least one alphanumeric character.")
    return sanitized


def get_checkpoint_file(git_root: Path, checkpoint_name: str) -> Path:
    return git_root / STATE_CHECKPOINT_DIR / f"{checkpoint_name}.json"


def get_checkpoint_patch_file(git_root: Path, checkpoint_name: str) -> Path:
    return git_root / STATE_CHECKPOINT_DIR / f"{checkpoint_name}.patch"


def _capture_repo_state(git_root: Path, checkpoint_name: str, label: str) -> dict:
    """Capture branch + uncommitted changes for one git repo. Returns a state dict."""
    state_dir = git_root / STATE_CHECKPOINT_DIR
    state_dir.mkdir(parents=True, exist_ok=True)
    patch_path = get_checkpoint_patch_file(git_root, f"{checkpoint_name}-{label}" if label != "main" else checkpoint_name)

    branch = get_git_branch(git_root) or "unknown"
    status_lines = list_git_status(git_root)
    uncommitted_changes = bool(status_lines)

    if uncommitted_changes:
        staged = run_git_command(["diff", "--patch", "--staged"], cwd=git_root)
        unstaged = run_git_command(["diff", "--patch"], cwd=git_root)
        untracked = run_git_command(["ls-files", "--others", "--exclude-standard"], cwd=git_root)
        untracked_diffs = []
        if untracked.stdout:
            for filepath in untracked.stdout.splitlines():
                if not filepath.strip():
                    continue
                diff_cmd = run_git_command(["diff", "--no-index", "--patch", os.devnull, filepath], cwd=git_root)
                untracked_diffs.append(diff_cmd.stdout or "")
        patch_path.write_text(
            (staged.stdout or "") + (unstaged.stdout or "") + "".join(untracked_diffs),
            encoding="utf-8",
        )
    elif patch_path.exists():
        patch_path.unlink()

    return {
        "branch": branch,
        "remote_url": git_remote_get_url(git_root) or "",
        "uncommitted_changes": uncommitted_changes,
        "patch_file": str(patch_path.relative_to(git_root)) if uncommitted_changes else None,
    }


def _list_submodules(git_root: Path) -> list[tuple[str, Path]]:
    """Return list of (rel_path, abs_path) for all registered submodules."""
    result = run_git_command(
        ["submodule", "foreach", "--quiet", "--recursive", "echo $displaypath"],
        cwd=git_root,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return []
    submodules = []
    for rel in result.stdout.splitlines():
        rel = rel.strip()
        if rel:
            submodules.append((rel, git_root / rel))
    return submodules


def save_workstate(checkpoint_name: str | None = None, description: str | None = None) -> None:
    git_root = find_git_root(Path.cwd())
    if git_root is None:
        fail("No git repository found. Run 'karya workstate save' from inside a repository.")

    checkpoint = sanitize_checkpoint_name(checkpoint_name)

    main_state = _capture_repo_state(git_root, checkpoint, "main")

    submodule_states: dict[str, dict] = {}
    for rel, sub_root in _list_submodules(git_root):
        if sub_root.exists():
            submodule_states[rel] = _capture_repo_state(sub_root, checkpoint, rel.replace("/", "-"))

    checkpoint_data = {
        "checkpoint_id": uuid.uuid4().hex,
        "checkpoint_name": checkpoint,
        "description": description or "",
        "created_at": datetime.datetime.now().isoformat(),
        **main_state,
        "submodules": submodule_states,
    }

    checkpoint_path = get_checkpoint_file(git_root, checkpoint)
    checkpoint_path.write_text(json.dumps(checkpoint_data, indent=2), encoding="utf-8")
    print(f"Saved workstate '{checkpoint}': branch={main_state['branch']}", end="")
    if submodule_states:
        sub_summary = ", ".join(f"{r}@{s['branch']}" for r, s in submodule_states.items())
        print(f", submodules=[{sub_summary}]", end="")
    print()
    if main_state["uncommitted_changes"]:
        print(f"  Uncommitted changes captured in {main_state['patch_file']}")


def _restore_repo_state(git_root: Path, state: dict, label: str, apply_patch: bool) -> None:
    """Checkout branch, pull, and optionally apply uncommitted patch for one repo."""
    target_branch = state.get("branch", "")
    if not target_branch or target_branch == "unknown":
        print(f"  [{label}] No branch recorded — skipping checkout.")
        return

    current_branch = get_git_branch(git_root)
    if current_branch != target_branch:
        result = run_git_command(["checkout", target_branch], cwd=git_root)
        if result.returncode != 0:
            # Branch may not exist locally yet — try creating tracking branch
            result = run_git_command(
                ["checkout", "-b", target_branch, f"origin/{target_branch}"],
                cwd=git_root,
            )
        if result.returncode != 0:
            print(f"  [{label}] Warning: could not checkout '{target_branch}': {result.stderr.strip()}")
            return
        print(f"  [{label}] Checked out branch '{target_branch}'")
    else:
        print(f"  [{label}] Already on branch '{target_branch}'")

    # Pull to get latest remote state
    pull = run_git_command(["pull", "--ff-only"], cwd=git_root)
    if pull.returncode != 0:
        print(f"  [{label}] Warning: pull failed (non-fast-forward?): {pull.stderr.strip()}")

    patch_file = state.get("patch_file")
    if patch_file:
        patch_path = git_root / patch_file
        if patch_path.exists():
            if apply_patch:
                result = run_git_command(["apply", "--index", str(patch_path)], cwd=git_root)
                if result.returncode != 0:
                    print(f"  [{label}] Warning: patch did not apply cleanly: {result.stderr.strip()}")
                    print(f"    Patch saved at: {patch_path}")
                else:
                    print(f"  [{label}] Applied uncommitted changes from patch.")
            else:
                print(f"  [{label}] Uncommitted changes patch available: {patch_path}")
        else:
            print(f"  [{label}] Warning: patch file recorded but not found: {patch_path}")


def resume_workstate(
    checkpoint_name: str | None = None,
    apply_patch: bool = False,
    project_root: Path | None = None,
) -> None:
    if project_root is not None:
        git_root = project_root
    else:
        git_root = find_git_root(Path.cwd())
    if git_root is None:
        fail("No git repository found. Run 'karya workstate resume' from inside a repository.")

    checkpoint = sanitize_checkpoint_name(checkpoint_name)
    checkpoint_path = get_checkpoint_file(git_root, checkpoint)
    if not checkpoint_path.exists():
        fail(f"Checkpoint not found: {checkpoint_path}")

    data = json.loads(checkpoint_path.read_text(encoding="utf-8"))
    print(f"Resuming workstate '{data['checkpoint_name']}' (saved {data['created_at']})")

    _restore_repo_state(git_root, data, git_root.name, apply_patch)

    for rel, sub_state in data.get("submodules", {}).items():
        sub_root = git_root / rel
        if sub_root.exists():
            _restore_repo_state(sub_root, sub_state, rel, apply_patch)
        else:
            print(f"  [{rel}] Submodule directory not found — run: git submodule update --init --remote")


def list_workstate() -> None:
    git_root = find_git_root(Path.cwd())
    if git_root is None:
        fail("No git repository found. Run 'karya workstate list' from inside a repository.")

    state_dir = git_root / STATE_CHECKPOINT_DIR
    if not state_dir.exists():
        print("No saved work state checkpoints found.")
        return

    files = sorted(state_dir.glob("*.json"))
    if not files:
        print("No saved work state checkpoints found.")
        return

    print("Saved work state checkpoints:")
    for file_path in files:
        data = json.loads(file_path.read_text(encoding="utf-8"))
        print(f"  {data.get('checkpoint_name', file_path.stem)}: {data.get('created_at', 'unknown')}")

# ── git helpers ───────────────────────────────────────────────────────────────

def run_git_command(args: list[str], cwd: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=str(cwd),
        capture_output=True,
        text=True,
        check=False,
    )


def find_git_root(project_root: Path) -> Path | None:
    result = run_git_command(["rev-parse", "--show-toplevel"], cwd=project_root)
    if result.returncode != 0:
        return None
    git_root = Path(result.stdout.strip())
    if not git_root.exists():
        return None
    if git_root not in project_root.parents and git_root != project_root:
        return None
    return git_root


def discover_git_remote(project_root: Path) -> str | None:
    result = run_git_command(["rev-parse", "--show-toplevel"], cwd=project_root)
    if result.returncode != 0:
        return None
    git_root = Path(result.stdout.strip())
    remote_result = run_git_command(["config", "--get", "remote.origin.url"], cwd=git_root)
    if remote_result.returncode != 0:
        return None
    return remote_result.stdout.strip() or None


def get_git_branch(git_root: Path) -> str | None:
    result = run_git_command(["rev-parse", "--abbrev-ref", "HEAD"], cwd=git_root)
    return result.stdout.strip() if result.returncode == 0 else None


def get_git_commit_hash(git_root: Path) -> str | None:
    result = run_git_command(["rev-parse", "HEAD"], cwd=git_root)
    return result.stdout.strip() if result.returncode == 0 else None


def list_git_status(git_root: Path) -> list[str]:
    result = run_git_command(["status", "--porcelain"], cwd=git_root)
    if result.returncode != 0:
        return []
    return [line for line in result.stdout.splitlines() if line.strip()]


def git_remote_get_url(git_root: Path) -> str | None:
    result = run_git_command(["remote", "get-url", "origin"], cwd=git_root)
    return result.stdout.strip() or None if result.returncode == 0 else None


def git_remote_add_origin(git_root: Path, repo_url: str) -> bool:
    existing = git_remote_get_url(git_root)
    if existing is not None:
        return existing == repo_url
    result = run_git_command(["remote", "add", "origin", repo_url], cwd=git_root)
    if result.returncode == 0:
        run_git_command(["fetch", "origin"], cwd=git_root)
    return result.returncode == 0


def git_remote_is_empty(git_root: Path) -> bool | None:
    result = run_git_command(["ls-remote", "origin"], cwd=git_root)
    if result.returncode != 0:
        return None
    return result.stdout.strip() == ""


def git_push_current_branch(git_root: Path) -> bool:
    result = run_git_command(["push", "-u", "origin", "HEAD", "--force-with-lease"], cwd=git_root)
    return result.returncode == 0

# ── github helpers ────────────────────────────────────────────────────────────

def gh_get_authenticated_user() -> str | None:
    """Return the GitHub login of the currently authenticated user, or None."""
    result = subprocess.run(
        ["gh", "api", "user", "--jq", ".login"],
        capture_output=True, text=True, check=False,
    )
    if result.returncode == 0:
        return result.stdout.strip() or None
    return None


def gh_available() -> bool:
    result = subprocess.run(["gh", "--version"], capture_output=True, text=True)
    if result.returncode != 0:
        return False
    auth = subprocess.run(["gh", "auth", "status"], capture_output=True, text=True)
    if auth.returncode != 0:
        print("GitHub CLI is not authenticated. Run: gh auth login")
        return False
    return True


def parse_github_repo_from_url(url: str) -> tuple[str, str] | None:
    match = re.search(r"github\.com[:/](?P<owner>[^/]+)/(?P<repo>[^/]+?)(?:\.git)?$", url)
    if not match:
        return None
    return match.group("owner"), match.group("repo")


def gh_repo_exists(owner: str, repo: str) -> bool | None:
    result = subprocess.run(["gh", "repo", "view", f"{owner}/{repo}"], capture_output=True, text=True)
    if result.returncode == 0:
        return True
    stderr = result.stderr.lower()
    if "not found" in stderr or "could not resolve" in stderr or "unable to" in stderr:
        return False
    return None


def gh_create_repo(owner: str, repo: str, private: bool = False) -> bool:
    args = ["gh", "repo", "create", f"{owner}/{repo}", "--private" if private else "--public"]
    return subprocess.run(args, capture_output=True, text=True).returncode == 0

# ── CLI entry point ───────────────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(
        prog="karya",
        description="Personal workspace manager. URIs use the kosh:// scheme (e.g. kosh://learning/mit/6s081).",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # init workspace
    init_parser = subparsers.add_parser("init")
    init_sub = init_parser.add_subparsers(dest="entity", required=True)
    init_sub.add_parser("workspace")

    # create project
    create_parser = subparsers.add_parser("create")
    create_sub = create_parser.add_subparsers(dest="entity", required=True)
    create_project_parser = create_sub.add_parser("project")
    create_project_parser.add_argument("--uri", required=True, help="kosh:// URI, e.g. kosh://learning/mit/6s081")
    mode_group = create_project_parser.add_mutually_exclusive_group()
    mode_group.add_argument("--continue", dest="mode", action="store_const", const="continue",
                            help="Resume post-create hooks on an interrupted project")
    mode_group.add_argument("--restart", dest="mode", action="store_const", const="restart",
                            help="Delete the project and recreate from scratch")
    create_project_parser.add_argument("--no-publish", dest="no_publish", action="store_true",
                            help="Skip publishing to GitHub after setup (use when testing)")

    # publish project
    publish_parser = subparsers.add_parser("publish")
    publish_sub = publish_parser.add_subparsers(dest="entity", required=True)
    publish_project_parser = publish_sub.add_parser("project")
    publish_project_parser.add_argument("--uri", help="kosh:// or file:// URI of the project")
    publish_project_parser.add_argument("--owner", help="GitHub username to derive repo URL")
    publish_project_parser.add_argument("--repo-url", help="Explicit repository URL")

    # remove project
    remove_parser = subparsers.add_parser("remove")
    remove_sub = remove_parser.add_subparsers(dest="entity", required=True)
    remove_project_parser = remove_sub.add_parser("project")
    remove_project_parser.add_argument("--uri", required=True, help="kosh:// or file:// URI of the project to remove")

    # workstate
    workstate_parser = subparsers.add_parser("workstate")
    workstate_sub = workstate_parser.add_subparsers(dest="subcommand", required=True)
    ws_save = workstate_sub.add_parser("save")
    ws_save.add_argument("name", nargs="?", help="Checkpoint name (default: latest)")
    ws_save.add_argument("--description", help="Optional description")
    ws_resume = workstate_sub.add_parser("resume")
    ws_resume.add_argument("name", nargs="?", help="Checkpoint name (default: latest)")
    ws_resume.add_argument("--apply", action="store_true", help="Apply saved patch without prompting")
    workstate_sub.add_parser("list")

    args = parser.parse_args()

    if args.command == "init" and args.entity == "workspace":
        init_workspace()
    elif args.command == "create" and args.entity == "project":
        create_project(args.uri, mode=getattr(args, "mode", None) or "new",
                       publish=not getattr(args, "no_publish", False))
    elif args.command == "publish" and args.entity == "project":
        publish_project(
            getattr(args, "uri", None),
            getattr(args, "repo_url", None),
            getattr(args, "owner", None),
        )
    elif args.command == "remove" and args.entity == "project":
        remove_project(args.uri)
    elif args.command == "workstate":
        if args.subcommand == "save":
            save_workstate(getattr(args, "name", None), getattr(args, "description", None))
        elif args.subcommand == "resume":
            resume_workstate(getattr(args, "name", None), getattr(args, "apply", False))
        elif args.subcommand == "list":
            list_workstate()
    else:
        parser.error("Unsupported command")


if __name__ == "__main__":
    main()

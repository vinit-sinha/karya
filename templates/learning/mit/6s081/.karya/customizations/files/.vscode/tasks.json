      "type": "shell",
      "command": "karya workstate save",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "karya [·] Checkpoint: list",
      "detail": "List all saved karya workstate checkpoints",
      "type": "shell",
      "command": "karya workstate list",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "karya [·] Checkpoint: resume",
      "detail": "Restore the latest karya workstate checkpoint",
      "type": "shell",
      "command": "karya workstate resume --apply",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "karya [·] Setup: re-run post-create",
      "detail": "Re-run setup hooks (idempotent — safe to run any time)",
      "type": "shell",
      "command": "karya create project --uri kosh://learning/mit/6s081 --continue",
      "options": { "cwd": "${workspaceFolder}/../../.." },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "always", "panel": "shared" }
    }

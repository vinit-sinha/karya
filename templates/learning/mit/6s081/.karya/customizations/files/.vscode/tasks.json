    {
      "label": "karya [0] Open Courseware",
      "detail": "Start the local courseware server and open http://localhost:7681 in your browser",
      "type": "shell",
      "command": "open http://localhost:7681",
      "windows": { "command": "start http://localhost:7681" },
      "linux": { "command": "xdg-open http://localhost:7681" },
      "dependsOn": "karya [~] Courseware: start server",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": false },
      "presentation": { "reveal": "never", "panel": "shared" }
    },

    { "label": "karya [util:1] Lab: start",    "detail": "Lab 1 of 10 — checkout util branch, create work/util/notes.md, save start checkpoint",  "type": "shell", "command": "bash scripts/lab-start.sh util",    "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": [], "group": { "kind": "build", "isDefault": false }, "presentation": { "reveal": "always", "panel": "shared",    "clear": false } },
    { "label": "karya [util:2] xv6: boot",     "detail": "Lab 1 of 10 — boot xv6 in QEMU (Ctrl-a x to exit)",                                    "type": "shell", "command": "make qemu",                        "options": { "cwd": "${workspaceFolder}/starter-code/xv6-labs-2021" }, "problemMatcher": [], "group": { "kind": "build", "isDefault": false }, "presentation": { "reveal": "always", "panel": "dedicated", "clear": true } },

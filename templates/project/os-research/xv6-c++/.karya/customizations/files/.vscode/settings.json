{
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "files.associations": {
    "*.h": "cpp",
    "*.c": "cpp"
  },
  "C_Cpp.default.compilerPath": "/opt/homebrew/bin/riscv64-unknown-elf-g++",
  "C_Cpp.default.intelliSenseMode": "gcc-arm64",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/kernel/xv6-riscv",
    "${workspaceFolder}/kernel/xv6-riscv/kernel",
    "${workspaceFolder}/kernel/xv6-riscv/user"
  ],
  "C_Cpp.default.defines": [
    "__riscv",
    "__riscv_xlen=64"
  ],
  "workbench.startupEditor": "none"
}

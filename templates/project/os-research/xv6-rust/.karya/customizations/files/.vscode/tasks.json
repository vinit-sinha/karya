{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "xv6-rust: build",
      "type": "shell",
      "command": "./scripts/build.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "xv6-rust: clean",
      "type": "shell",
      "command": "toolchain/current/cargo clean",
      "options": { "cwd": "${workspaceFolder}/src" },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "xv6-rust: run (QEMU)",
      "type": "shell",
      "command": "./scripts/run.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "xv6-rust: debug (QEMU + GDB stub)",
      "type": "shell",
      "command": "./scripts/debug.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Checkpoint: save",
      "type": "shell",
      "command": "karya workstate save",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Checkpoint: resume",
      "type": "shell",
      "command": "karya workstate resume --apply",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
